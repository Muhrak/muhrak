# Copy to .env.local.
# The browser only ever calls this site; /api/* is proxied (server side) to
# the Muhrak API so the session cookie is first-party. No trailing slash.
API_ORIGIN=http://localhost:4000

# Origin of the private S3 bucket (https://<bucket>.s3.<region>.amazonaws.com).
# Browsers upload straight to it, so the CSP must allow it (connect-src, img-src).
STORAGE_ORIGIN=https://muhrak-staging-private-xxxx.s3.eu-north-1.amazonaws.com
