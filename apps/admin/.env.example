# Copy to .env.local.
# The browser only calls this site; /api/* is proxied (server side) to the
# Muhrak API, so the admin session cookie is first-party. No trailing slash.
API_ORIGIN=http://localhost:4000

# Origin of the private S3 bucket. Admins open documents through short-lived
# signed links on this origin (img-src in the CSP for image previews).
STORAGE_ORIGIN=https://muhrak-staging-private-xxxx.s3.eu-north-1.amazonaws.com
