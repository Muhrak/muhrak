# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://muhrak:muhrak@localhost:5432/muhrak
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Public URL of the web app, used for links in emails (no trailing slash)
WEB_APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
