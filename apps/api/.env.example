# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://muhrak:muhrak@localhost:5432/muhrak
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of web origins allowed to call the API. Also the CSRF
# check: login, sign-up, refresh and logout are refused from any other origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Proxies in front of the API that add to X-Forwarded-For (for the real client
# IP in rate limits). 0 locally. Staging: see docs/DEPLOY.md. Too high lets
# clients fake their IP.
TRUST_PROXY_HOPS=0

# Path of the refresh-token cookie as the browser sees it (the web app
# proxies /api/* to this API).
AUTH_COOKIE_PATH=/api/v1/auth

# Public URL of the web app, used for links in emails (no trailing slash)
WEB_APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# Private file storage (Amazon S3). See docs/DEPLOY.md "File storage".
# The IAM user needs only s3:PutObject and s3:GetObject on this bucket.
# Leave empty to run without uploads (upload endpoints answer 503).
AWS_REGION=eu-north-1
S3_BUCKET_PRIVATE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
